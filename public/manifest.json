{
  "manifest_version": 3,
  "name": "Clean X Link",
  "version": "1.0.0",
  "description": "Copies X/Twitter post links without tracking parameters. Requests no permissions.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
